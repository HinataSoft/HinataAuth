{
  "PathBase": "",
  "AuthCredentials": {
    "credentials": [
      {
        "id": "test-subject",
        "secret": "test-secret",
        "scopes": "auth profile email",
        "claims": {
          "name": "Test User",
          "email": "test@example.com"
        }
      }
    ]
  },
  "AuthorizationCode": {
    "codeExpirationMinutes": 10,
    "defaultRedirectUri": "http://localhost:3000/callback",
    "clients": [
      {
        "clientId": "auth-client",
        "clientSecret": "auth-secret",
        "scopes": "auth profile email",
        "redirectUris": [
          "http://localhost:3000/callback",
          "http://127.0.0.1:3000/callback",
          "http://localhost:5999/authtest.html",
          "http://127.0.0.1:5999/authtest.html"
        ]
      }
    ]
  },
  "Jwt": {
    "issuer": "HinataAuth",
    "audience": "HinataAuth",
    "expirationMinutes": 60,
    "keyId": "test-signing-key",
    "refreshToken": {
      "expirationDays": 7
    }
  },
  "DynamicClientRegistration": {
    "enabled": true,
    "allowConfidentialClients": true,
    "allowedScopes": ["auth", "profile", "email"],
    "clientStorePath": "run/test-clients.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
